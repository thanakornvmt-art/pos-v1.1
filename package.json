{
  "name": "morning-pos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/precache.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "deploy:check": "node scripts/check-deploy-env.mjs",
    "deploy:migrate": "prisma migrate deploy",
    "deploy:seed": "node --import tsx prisma/seed.ts",
    "db:local": "node scripts/local-db.mjs",
    "setup:local": "node scripts/setup-env.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@prisma/client": "6.19.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.90.2",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dexie": "^4.2.0",
    "jose": "^5.10.0",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "next-auth": "4.24.13",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.18.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "embedded-postgres": "18.4.0-beta.17",
    "fake-indexeddb": "^6.2.2",
    "postcss": "^8.5.6",
    "prettier": "^3.9.8",
    "prisma": "6.19.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
